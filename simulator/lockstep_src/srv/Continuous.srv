# START installs an initial action before unpausing. APPLY never steps or pauses.
uint8 SNAPSHOT=0
uint8 START=1
uint8 APPLY=2
uint8 STOP=3
uint8 command
uint64 sequence
float64 rudder
float64 sail
float64 sail2
---
bool success
string status_message
uint64 sequence
uint64 iteration
time sim_time
float64 step_size
geometry_msgs/Pose pose
geometry_msgs/Twist twist
sensor_msgs/JointState joints
